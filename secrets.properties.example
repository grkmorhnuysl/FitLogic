# On-device MediaPipe LLM model used by the Android app.
# Development default follows Google's adb workflow:
# adb shell mkdir -p /data/local/tmp/llm/
# adb push ~/fitlogic/models/gemma-2b-it.bin /data/local/tmp/llm/
